# Kopiera till .env på servern (/srv/capital-radar/.env). Aldrig i Git.

# Vilka extra tjänster docker compose startar. Lägg till "backup" när
# Object Storage är klart och "public" när Cloudflare-tunneln finns.
COMPOSE_PROFILES=

# Token för skrivningar i webben (spara vikter, prioritera sammanfattning).
# Generera:  openssl rand -hex 32
SCREENER_ADMIN_API_TOKEN=

# --- AI ---
# Övriga SCREENER_*/DEEPSEEK_* från den gamla tjänsten kan kopieras över
# oförändrade; alla har fungerande defaults (se src/capital_radar/config.py).
DEEPSEEK_API_KEY=

# --- Backup (profil "backup"), Hetzner Object Storage ---
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://hel1.your-objectstorage.com
LITESTREAM_REGION=hel1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Publik åtkomst (profil "public"), Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# Tidsgräns i sekunder för bakgrundsbygget av transaktionsflödets läsmodell
# (max 900). Första bygget på produktionsdatabasen tar flera minuter.
SCREENER_READ_MODEL_REFRESH_TIMEOUT=600
