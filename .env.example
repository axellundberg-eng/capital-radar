# Kopiera till .env på servern (/srv/capital-radar/.env). Aldrig i Git.

# --- AI ---
# Övriga SCREENER_*/DEEPSEEK_* från den gamla tjänsten kan kopieras över
# oförändrade; alla har fungerande defaults (se src/capital_radar/config.py).
DEEPSEEK_API_KEY=

# --- Oberoende granskare (Claude Haiku via Anthropic API) ---
# Tom nyckel = granskaren är avstängd; resten av tjänsten påverkas inte.
ANTHROPIC_API_KEY=
REVIEWER_MODEL=claude-haiku-5-5
# REVIEWER_EFFORT=medium
# REVIEWER_MAX_OUTPUT_TOKENS=8000
# Tidsgränser i sekunder; connect <= read < hard <= 180 (AGENTS.md).
# REVIEWER_CONNECT_TIMEOUT_SECONDS=10
# REVIEWER_READ_TIMEOUT_SECONDS=90
# REVIEWER_HARD_TIMEOUT_SECONDS=120
# REVIEWER_MAX_SOURCE_CHARS=24000
# REVIEWER_HEADLINE_BATCH_SIZE=40

# --- Backup (profil "backup"), Hetzner Object Storage ---
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://hel1.your-objectstorage.com
LITESTREAM_REGION=hel1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Publik åtkomst (profil "public"), Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
